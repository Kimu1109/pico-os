.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.venv
__pycache__/
# PC/Webビルド(pc/CMakeLists.txt)の生成物
# 画面の大きさ別のビルド(pc/build-320x480 等。pc/README.md「画面の大きさを変える」)も含む
pc/build*/
pc/build-web/
pc/sdcard/sys/log.txt
pc/sdcard/sys/log.old.txt
# Claude Codeのworktree隔離エージェント(isolation: "worktree")が作る一時チェックアウト
.claude/worktrees/
pc/sdcard/sys/wifi.cfg
pc/sdcard/sys/wifi.cfg.tmp
# TODOアプリのトークン(PCで試すときに置く。秘密なのでコミットしない)
pc/sdcard/sys/todoist.cfg
pc/sdcard/sys/todoist.cfg.tmp
# メールアプリのアカウント(PCで試すときに置く。秘密なのでコミットしない)
pc/sdcard/sys/mail.cfg
pc/sdcard/sys/mail_token.cfg
pc/sdcard/sys/mail_token.cfg.tmp
pc/sdcard/sys/mail.cfg.tmp
# 開発者向けの道具(/sys/debug.cfg)とクラッシュダンプ。PCビルドで試すと作られる
pc/sdcard/sys/debug.cfg
pc/sdcard/sys/notify_rules.tsv
pc/sdcard/sys/debug.cfg.tmp
pc/sdcard/sys/home.cfg
pc/sdcard/sys/home.cfg.tmp
pc/sdcard/sys/todo_cache.tsv
pc/sdcard/sys/todo_cache.tsv.tmp
# 最近開いたファイル(RecentFiles)
pc/sdcard/sys/recent_files.txt
pc/sdcard/sys/recent_files.txt.tmp
pc/sdcard/sys/crash.pending
pc/sdcard/crash/

# Luaアプリの pico.store_save() が作る保存ファイル(PCビルドで試すと作られる)
pc/sdcard/lua/apps/*/store.json
pc/sdcard/lua/apps/*/store.json.tmp
# ニュースアプリが保存するRSS(save_to。.part は受信中)
pc/sdcard/lua/apps/*/news.xml
pc/sdcard/lua/apps/*/news.xml.part
pc/sdcard/lua/apps/*/settings.cfg
pc/sdcard/lua/apps/*/results.txt
# マイクの動作確認(mic.lua)・pico.mic_start() が録るファイルと、録音アプリの置き場
pc/sdcard/lua/apps/*/rec_*.wav
pc/sdcard/recordings/
pc/sdcard/lua/apps/*/bench.tmp
pc/sdcard/lua/apps/*/spotify_auth.json
pc/sdcard/lua/apps/Spotify/art.jpg
pc/sdcard/lua/apps/Spotify/art.jpg.part
pc/sdcard/lua/apps/Spotify/player.json
# 「ブロック」のセーブ(PCビルドで試すと作られる)
pc/sdcard/lua/apps/ブロック/worlds/
# アプリストア(PCビルドで試すと作られる。store.cfg には試すときの url/key を書く)
pc/sdcard/sys/store/
pc/sdcard/sys/store.cfg
# OTPの端末の鍵(PC/Webビルドが真似るファイル)
pc/otp_emu.bin
pc/ota_emu/
pc/sdcard/lua/apps/*/log.csv
# ホストテストのビルド(script/host_test/run.sh が作る)
script/host_test/build/
# 辞書の材料から作ったSD用のファイル(script/dict/build.sh が作る)
script/dict/out/
# picoos lua-test が作るLuaのテストの下請け(script/lua_test/pico_lua_test.c)
script/lua_test/build/
