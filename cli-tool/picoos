def _pc_build_dir(web: bool, name=None) -> Path:
    base = "build-web" if web else "build"
    return PC_DIR / (f"{base}-{name}" if name else base)


def _pc_binary(name=None):
    binary = _pc_build_dir(web=False, name=name) / "picoos_pc"
    if not binary.exists():
        hint = f" --name {name}" if name else ""
        print(f"[picoos] {binary} がありません。先に `picoos pc build{hint}` を実行してください。",
              file=sys.stderr)
        return None
    return binary


def cmd_pc_build(args) -> int:
    try:
        config = pb.config_from_args(args)
        if args.save_profile:
            pb.save_profile(args.save_profile, config)
            print(f"[picoos] 条件を {args.save_profile} として保存しました", file=sys.stderr)
    except pb.BuildError as e:
        print(f"[picoos] {e}", file=sys.stderr)
        return 2
    # --name が無ければ、保存した条件の名前か env の名前(rpipico2w_ を除く)で分ける。
    # 何も付けなければ pc/build
    if not args.name:
        if args.profile:
            args.name = args.profile
        elif args.env and args.env != pb.DEFAULT_ENV:
            args.name = args.env[len(pb.DEFAULT_ENV) + 1:] if args.env.startswith(pb.DEFAULT_ENV + "_") else args.env
    if args.name and not re.fullmatch(r"[A-Za-z0-9._-]+", args.name):
        print(f"[picoos] --name は英数字と . _ - だけにしてください: {args.name!r}", file=sys.stderr)
        return 2
    for note in config.pc_ignored():
        print(f"[picoos] 注意: PCビルドでは {note} は効きません", file=sys.stderr)
    if not config.is_default():
        print("[picoos] ビルドの条件:\n" + _indent(config.describe()), file=sys.stderr)
    build_dir = _pc_build_dir(args.web, args.name)
    rel_build_dir = build_dir.relative_to(REPO_ROOT)
    if args.web:
        configure_cmd = ["emcmake", "cmake", "-S", "pc", "-B", str(rel_build_dir),
                          "-DCMAKE_BUILD_TYPE=Release"]
    else:
        configure_cmd = ["cmake", "-S", "pc", "-B", str(rel_build_dir)]
    # 条件を付けたときは全部の値を渡す(キャッシュに前の条件が残らないように。BuildConfig.cmake_args)。
    # 何も付けなければ、作ってある場所の条件(CMakeCache.txt)のまま作り直す(--clean でも読んでから消す)。
    # --reset で既定へ戻す
    cache = build_dir / "CMakeCache.txt"
    if not pb.has_build_options(args) and not args.reset and cache.exists():
        print(f"[picoos] 条件は {rel_build_dir} の前回のまま(既定へ戻すときは --reset)", file=sys.stderr)
        if args.clean:
            configure_cmd += pb.cached_cmake_args(cache)
    else:
        configure_cmd += config.cmake_args()
    if args.dry_run:
        if args.clean:
            print(f"rm -rf {rel_build_dir}")
        print(" ".join(configure_cmd))
        print(f"cmake --build {rel_build_dir} -j {args.jobs}")
        return 0
    if args.clean and build_dir.exists():
        print(f"[picoos] 既存のビルドディレクトリを削除します: {build_dir}", file=sys.stderr)
        shutil.rmtree(build_dir)

    rc = run(configure_cmd, cwd=REPO_ROOT)
    if rc != 0:
        if args.web:
            print("[picoos] emcmake が無い場合は emsdk を source してください"
                  " (source /path/to/emsdk/emsdk_env.sh)。詳細は pc/README.md 参照。",
                  file=sys.stderr)
        return rc

    return run(["cmake", "--build", str(rel_build_dir), "-j", str(args.jobs)], cwd=REPO_ROOT)


def cmd_pc_run_raw(rest) -> int:
    # 先頭の --name NAME(か --name=NAME)だけ picoos が読み、pc/build-NAME の版を動かす
    name = None
    if rest[:1] == ["--name"] and len(rest) >= 2:
        name, rest = rest[1], rest[2:]
    elif rest and rest[0].startswith("--name="):
        name, rest = rest[0].split("=", 1)[1], rest[1:]
    if rest[:1] == ["--"]:
        rest = rest[1:]
    binary = _pc_binary(name)
    if binary is None:
        return 1
    return run([str(binary), *rest], cwd=REPO_ROOT)


def cmd_pc_shot(args) -> int:
    binary = _pc_binary(args.name)
    if binary is None:
        return 1

    cmd = [str(binary)]
    for tap in args.tap:
        cmd += ["--tap", tap]
    cmd += ["--shot", args.out_ppm]
    if args.frames is not None:
        cmd += [str(args.frames)]

    env = dict(os.environ)
    # dummyドライバはSDL_RENDERER_ACCELERATED系のレンダラーを作れず、LovyanGFXの
    # Panel_sdlが毎フレームウィンドウを作り直してヒープが際限なく増え続ける
    # (pc/patches/README.md参照。パッチで緩和はしてあるが、そもそも踏まないoffscreenを使う)
    env["SDL_VIDEODRIVER"] = "offscreen"
    rc = run(cmd, cwd=REPO_ROOT, env=env)
    if rc != 0 or not args.png:
        return rc

    return run_py("ppm2png.py", [args.out_ppm, args.png, str(args.scale)])


def _resolve_app_name(app: str) -> str:
    """--app へ渡す名前。ディレクトリ(pc/sdcard/lua/apps/テトリス 等)なら app.cfg の name、
    無ければフォルダ名。ディレクトリでなければランチャの名前としてそのまま使う。"""
    path = Path(app)
    if not path.is_dir():
        return app
    cfg = path / "app.cfg"
    if cfg.is_file():
        for line in cfg.read_text(encoding="utf-8", errors="replace").splitlines():
            key, sep, value = line.partition("=")
            if sep and key.strip() == "name" and value.strip():
                return value.strip()
    return path.resolve().name


def cmd_pc_dev(args) -> int:
    # Luaアプリのホットリロード。picoos_pc の --hot-reload が、開いたLuaアプリのフォルダの
    # .lua / app.cfg の保存を見張り、変わったら同じ引数で起動し直す(pc/README.md「ホットリロード」)
    binary = _pc_binary(args.name)
    if binary is None:
        return 1
    cmd = [str(binary), "--app", _resolve_app_name(args.app), "--hot-reload"]
    if args.scene:
        cmd += ["--scene", args.scene]
    rest = args.rest[1:] if args.rest[:1] == ["--"] else args.rest
    cmd += rest
    return run(cmd, cwd=REPO_ROOT)


# ---- Luaアプリのテスト(picoos lua-test) ----

def _lua_test_binary() -> Path:
    """script/lua_test/pico_lua_test を(無いか古ければ)ccで作って返す。vendorしたLua(lib/lua)を
    そのままビルドするので、数の扱い(LUA_32BITS)は実機と同じ。失敗したらNone。"""
    out_dir = LUA_TEST_DIR / "build"
    binary = out_dir / "pico_lua_test"
    sources = sorted((REPO_ROOT / "lib" / "lua" / "src").glob("*.c")) + [LUA_TEST_DIR / "pico_lua_test.c"]
    headers = list((REPO_ROOT / "lib" / "lua" / "src").glob("*.h"))
    if binary.exists():
        built = binary.stat().st_mtime
        if all(p.stat().st_mtime <= built for p in sources + headers):
            return binary
    out_dir.mkdir(parents=True, exist_ok=True)
    cc = os.environ.get("CC", "cc")
    print(f"[picoos] Luaのテストの下請けを作ります: {binary.relative_to(REPO_ROOT)}", file=sys.stderr)
    # 出力は失敗したときだけ見せる(loslib.c の tmpnam へのリンカの警告は、os.tmpname を
    # アプリへ見せないので無関係。LUA_USE_LINUX 等は付けず実機と同じANSI構成のまま作る)
    cmd = [cc, "-O1", "-std=gnu99", "-w", "-I", str(REPO_ROOT / "lib" / "lua" / "src"),
           *[str(p) for p in sources], "-lm", "-o", str(binary)]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        print(f"[picoos] Cコンパイラが見つかりません: {cc}(環境変数CCで指定できます)", file=sys.stderr)
        return None
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout + proc.stderr)
        return None
    return binary


def _find_lua_tests(paths):
    """引数(ファイルかディレクトリ)から *_test.lua を集める。省略時は pc/sdcard/lua/apps/ の全アプリ。"""
    if not paths:
        paths = [str(LUA_APPS_DIR)]
    files = []
    for p in paths:
        path = Path(p)
        if path.is_file():
            files.append(path)
        elif path.is_dir():
            files += sorted(f for f in path.rglob("*_test.lua") if f.is_file())
        else:
            print(f"[picoos] 見つかりません: {p}", file=sys.stderr)
            return None
    return files


def cmd_lua_test(args) -> int:
    files = _find_lua_tests(args.paths)
    if files is None:
        return 2
    if not files:
        print("[picoos] テストファイル(*_test.lua)がありません。アプリのフォルダの tests/ に置いてください"
              " (lua-api-doc guide/app/testing.md)", file=sys.stderr)
        return 1
    if args.list:
        for f in files:
            print(os.path.relpath(f))
        return 0
    binary = _lua_test_binary()
    if binary is None:
        return 1
    cmd = [str(binary), str(REPO_ROOT)]
    if args.verbose:
        cmd.append("-v")
    if args.k:
        cmd += ["-k", args.k]
    # 表示を短くするため、テストファイルは今のディレクトリからの相対パスで渡す
    cmd += [os.path.relpath(f) for f in files]
    return run(cmd)


