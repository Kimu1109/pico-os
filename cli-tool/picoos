    p.add_argument("--list", action="store_true", help="見つかったテストファイルを並べるだけ")
    p.set_defaults(func=cmd_lua_test)

    return parser


def main() -> int:
    argv = sys.argv[1:]

    rc = try_dispatch_passthrough(argv)
    if rc is not None:
        return rc

    parser = build_parser()
    args = parser.parse_args(argv)
    if not hasattr(args, "func"):
        parser.print_help()
        return 1
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
