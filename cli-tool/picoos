def try_dispatch_passthrough(argv):
    """先頭トークン列が既知のルートに一致すれば実行してreturncodeを返す。
    一致しなければNone(=argparse側の通常処理へフォールバック)。"""
    for prefix, script in PASSTHROUGH_PY.items():
        n = len(prefix)
        if tuple(argv[:n]) == prefix:
            # "firmware_tool.py keygen" のようにサブコマンドまで決めてあるものは、その語も先に渡す
            name, *fixed = script.split()
            return run_py(name, [*fixed, *argv[n:]])
    if argv[:1] == ["test"]:
        return cmd_test_raw(argv[1:])
    if tuple(argv[:2]) == ("pc", "run"):
        return cmd_pc_run_raw(argv[2:])
    if tuple(argv[:2]) == ("fw", "monitor"):
        pio = find_pio()
        if pio is None:
            return 127
        return run([pio, "device", "monitor", *argv[2:]], cwd=REPO_ROOT)
    return None


