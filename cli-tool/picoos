# ---- CIと同じ確かめ(picoos check) ----

# (名前, 確かめるコマンド, 直すコマンド or None)。.github/workflows/host-tests.yml の「層の決まり」と同じ並び
_CHECKS = [
    ("層の決まり", ["check_layers.py"], None),
    ("同梱Luaモジュールの生成物", ["gen_lua_builtins.py", "--check"], ["gen_lua_builtins.py"]),
    ("Wi-Fi転送のページの生成物", ["gen_file_share_page.py", "--check"], ["gen_file_share_page.py"]),
    ("訳(i18n)", ["i18n.py", "--check"], ["i18n.py", "update"]),
]


def cmd_check(args) -> int:
    results = []
    for name, check, fix in _CHECKS:
        print(f"[picoos] === {name}", file=sys.stderr)
        rc = run([sys.executable, str(SCRIPT_DIR / check[0]), *check[1:]], cwd=REPO_ROOT)
        if rc != 0 and args.fix and fix:
            print("[picoos] --fix: 作り直します", file=sys.stderr)
            run([sys.executable, str(SCRIPT_DIR / fix[0]), *fix[1:]], cwd=REPO_ROOT)
            rc = run([sys.executable, str(SCRIPT_DIR / check[0]), *check[1:]], cwd=REPO_ROOT)
        results.append((name, rc, fix))
    if args.test:
        print("[picoos] === ホストテスト", file=sys.stderr)
        results.append(("ホストテスト", run(["sh", str(HOST_TEST_DIR / "run.sh")], cwd=REPO_ROOT), None))
    print("", file=sys.stderr)
    failed = 0
    for name, rc, fix in results:
        mark = "OK " if rc == 0 else "NG "
        hint = "" if rc == 0 or not fix or args.fix else "  (--fix で作り直せる)"
        print(f"  {mark} {name}{hint}", file=sys.stderr)
        failed += rc != 0
    return 1 if failed else 0


# ---- 道具がそろっているか(picoos doctor) ----

def _probe_module(python: str, module: str) -> bool:
    try:
        return subprocess.run([python, "-c", f"import {module}"], capture_output=True).returncode == 0
    except OSError:
        return False


def cmd_doctor(args) -> int:
    py = venv_python()
    rows = []

    def tool(label, ok, purpose, detail=""):
        rows.append((ok, label, purpose, detail))

    tool("python3", sys.version_info >= (3, 8), "このCLI・script/ の全部", sys.version.split()[0])
    venv = SCRIPT_DIR / ".venv"
    tool("script/.venv", venv.exists(), "アイコン・pimg の変換(無ければ今の python3 を使う)",
         "" if venv.exists() else "python3 -m venv script/.venv && script/.venv/bin/pip install -r script/requirements.txt")
    for mod, purpose in (("PIL", "pimg / pimg2png / gen / icons"), ("cairosvg", "icons"), ("numpy", "pvid")):
        tool(f"  {mod}", _probe_module(py, mod), purpose)
    pio = None
    for name in ("pio", "platformio"):
        pio = pio or shutil.which(name)
    if pio is None and (Path.home() / ".platformio" / "penv" / "bin" / "pio").exists():
        pio = str(Path.home() / ".platformio" / "penv" / "bin" / "pio")
    tool("pio", pio is not None, "実機ビルド(fw build)", pio or "pipx install platformio")
    tool("cmake", shutil.which("cmake") is not None, "PCビルド・ホストテスト")
    tool("c++", (shutil.which("c++") or shutil.which("g++") or shutil.which("clang++")) is not None,
         "PCビルド・ホストテスト")
    tool("cc", (os.environ.get("CC") and shutil.which(os.environ["CC"])) or shutil.which("cc") is not None,
         "lua-test")
    sdl = False
    if shutil.which("pkg-config"):
        sdl = subprocess.run(["pkg-config", "--exists", "sdl2"], capture_output=True).returncode == 0
    sdl = sdl or shutil.which("sdl2-config") is not None
    tool("SDL2", sdl, "PCビルド(ネイティブ)", "" if sdl else "apt install libsdl2-dev 等")
    tool("emcmake", shutil.which("emcmake") is not None, "Webビルド(pc build --web)",
         "" if shutil.which("emcmake") else "emsdk を入れて emsdk_env.sh を source")
    tool("ffmpeg", shutil.which("ffmpeg") is not None, "pvid(動画の変換)")
    tool("kicad-cli", shutil.which("kicad-cli") is not None, "hw check-pins(キャリアボード)")
    tool("git", shutil.which("git") is not None, "ファームの版の埋め込み")

    for ok, label, purpose, detail in rows:
        mark = "✓" if ok else "✗"
        line = f"  {mark} {label:<14} {purpose}"
        if detail:
            line += f"  [{detail}]"
        print(line)
    missing = [r for r in rows if not r[0]]
    print(f"\n{len(rows) - len(missing)}/{len(rows)} そろっています(✗ の道具は、その用途を使うときだけ要ります)")
    return 0


# ---- パーサ構築 ----
#
