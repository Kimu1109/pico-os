def cmd_fw_list(args) -> int:
    """作ってある実機のファームを並べる(.pio/build/* と .pio/build-variant/*/*)。"""
    found = sorted((REPO_ROOT / ".pio" / "build").glob("*/firmware.bin")) + \
        sorted(pb.VARIANT_BUILD_ROOT.glob("*/*/firmware.bin"))
    if not found:
        print("[picoos] 作ってあるファームはありません(picoos fw build)", file=sys.stderr)
        return 0
    import datetime
    for f in found:
        st = f.stat()
        when = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")
        rel = os.path.relpath(f, REPO_ROOT)
        pfw = " +pfw" if (f.parent / "firmware.pfw").exists() else ""
        print(f"{when}  {st.st_size:>10,}  {rel}{pfw}")
    return 0


def cmd_fw_clean(args) -> int:
    targets = [pb.VARIANT_BUILD_ROOT]
    if args.all:
        targets.append(REPO_ROOT / ".pio" / "build")
    for t in targets:
        if t.exists():
            print(f"[picoos] 消します: {os.path.relpath(t, REPO_ROOT)}", file=sys.stderr)
            shutil.rmtree(t)
    return 0


