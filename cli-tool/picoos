def _indent(text: str, prefix: str = "  ") -> str:
    return "\n".join(prefix + line for line in text.splitlines())


def find_pio():
    """pio / platformio を PATH か ~/.platformio/penv から探す。無ければ案内を出して None。"""
    for name in ("pio", "platformio"):
        found = shutil.which(name)
        if found:
            return found
    for candidate in (Path.home() / ".platformio" / "penv" / "bin" / "pio",
                      Path.home() / ".platformio" / "penv" / "Scripts" / "pio.exe"):
        if candidate.exists():
            return str(candidate)
    print("[picoos] PlatformIO(pio)が見つかりません。`pipx install platformio` 等で入れてください。", file=sys.stderr)
    return None


def _fmt_size(n: int) -> str:
    return f"{n:,} バイト({n / 1024 / 1024:.2f}MB)"


def _report_fw_size(bin_path: Path) -> int:
    """firmware.bin の大きさと上限(4MB - EEPROM - LittleFS)を出す。上限を超えていれば1。"""
    if not bin_path.exists():
        print(f"[picoos] {bin_path} がありません(まだ作っていない)", file=sys.stderr)
        return 1
    size = bin_path.stat().st_size
    limit = pb.firmware_limit()
    if limit is None:
        print(f"[picoos] ファーム: {_fmt_size(size)}", file=sys.stderr)
        return 0
    left = limit - size
    pct = 100.0 * size / limit
    print(f"[picoos] ファーム: {_fmt_size(size)} / 上限 {_fmt_size(limit)}  {pct:.1f}%  残り {left:,} バイト",
          file=sys.stderr)
    if left < 0:
        print("[picoos] 上限を超えています。Wi-Fi/SDからの更新ができません"
              "(platformio.ini の board_build.filesystem_size の注釈を参照)", file=sys.stderr)
        return 1
    if left < 64 * 1024:
        print("[picoos] 注意: 上限まで64KBを切っています", file=sys.stderr)
    return 0


def _fw_plan_from_args(args):
    config = pb.config_from_args(args)
    if getattr(args, "save_profile", None):
        pb.save_profile(args.save_profile, config)
        print(f"[picoos] 条件を {args.save_profile} として保存しました", file=sys.stderr)
    return config, pb.build_fw_plan(config, args.env, hint=getattr(args, "profile", None))


def _print_fw_plan(config, plan):
    print("[picoos] ビルドの条件:\n" + _indent(config.describe()), file=sys.stderr)
    print(f"[picoos] env: {plan.env}  構成: {plan.build_env_name}", file=sys.stderr)
    if plan.extra_flags:
        print(f"[picoos] 足す -D: {' '.join(plan.extra_flags)}", file=sys.stderr)
    print(f"[picoos] 作る場所: {os.path.relpath(plan.build_dir, REPO_ROOT)}", file=sys.stderr)


def cmd_fw_build(args) -> int:
    try:
        config, plan = _fw_plan_from_args(args)
    except pb.BuildError as e:
        print(f"[picoos] {e}", file=sys.stderr)
        return 2
    _print_fw_plan(config, plan)

    env = dict(os.environ)
    env.update(plan.environ())
    if os.environ.get("PLATFORMIO_BUILD_FLAGS") and plan.extra_flags:
        env["PLATFORMIO_BUILD_FLAGS"] = os.environ["PLATFORMIO_BUILD_FLAGS"] + " " + env["PLATFORMIO_BUILD_FLAGS"]

    conf, platform_desc = pb.project_conf(args.platform)
    print(f"[picoos] プラットフォーム: {platform_desc}", file=sys.stderr)
    base = ["pio", "run", "-e", plan.env]
    if conf is not None:
        base += ["-d", str(REPO_ROOT), "-c", os.path.relpath(conf, REPO_ROOT)]
    if args.jobs:
        base += ["-j", str(args.jobs)]
    if args.verbose:
        base.append("-v")
    steps = []
    if args.clean:
        steps.append(base + ["-t", "clean"])
    build = list(base)
    if args.upload:
        build += ["-t", "upload"]
        if args.port:
            build += ["--upload-port", args.port]
    steps.append(build)
    if args.pack:
        steps.append(base + ["-t", "fwpack"])
    if args.push:
        steps.append(base + ["-t", "fwpush", "--upload-port", args.push])

    if args.dry_run:
        for k, v in plan.environ().items():
            print(f"{k}={shlex_quote(v)} \\")
        for st in steps:
            print(" ".join(shlex_quote(c) for c in st))
        return 0

    pio = find_pio()
    if pio is None:
        return 127
    for st in steps:
        rc = run([pio, *st[1:]], cwd=REPO_ROOT, env=env)
        if rc != 0:
            return rc
        if st is build:
            size_rc = _report_fw_size(plan.bin_path)
            if size_rc != 0 and (args.pack or args.push):
                return size_rc
    if args.pack:
        print(f"[picoos] 更新ファイル: {os.path.relpath(plan.build_dir / 'firmware.pfw', REPO_ROOT)}", file=sys.stderr)
    if args.monitor:
        return run([pio, "device", "monitor", *(["--port", args.port] if args.port else [])], cwd=REPO_ROOT)
    return 0


def shlex_quote(s: str) -> str:
    import shlex
    return shlex.quote(str(s))


def cmd_fw_size(args) -> int:
    try:
        config, plan = _fw_plan_from_args(args)
    except pb.BuildError as e:
        print(f"[picoos] {e}", file=sys.stderr)
        return 2
    print(f"[picoos] 構成: {plan.build_env_name}  ({os.path.relpath(plan.bin_path, REPO_ROOT)})", file=sys.stderr)
    return _report_fw_size(plan.bin_path)


