# 実機の版(buildcfg/*.ini の env)の旗を、PCビルドでも同じ1か所から読む(docs/design/devtools.md「ビルドの構成の置き場所」)。
#
#   include から: picoos_read_variant(<env の名前> <出力のリスト>)
#                 出力は「NAME=VAL」の並び(-D の値が無ければ VAL=1)。土台の env:rpipico2w は空。
#   単独で:       cmake -DPICOOS_VARIANT=rpipico2w_music -P pc/cmake/PicoVariant.cmake
#                 1行に1つ NAME=VAL を出す(script/check_variants.py が PlatformIO の解釈と照らし合わせる)。
#
# 読めるのは buildcfg/ の書き方の決まりの範囲だけ(それ以外は黙って読み違えず FATAL_ERROR で止める):
#   - 版は `extends = env:rpipico2w` で、build_flags は ${env:rpipico2w.build_flags} ・ ${opt_xxx.flags} ・ -DNAME[=VAL] だけ
#   - 部品(opt_*)の flags は -DNAME[=VAL] だけ(${…} を入れ子にしない)
#   - コメントは行の頭の ; だけ

set(_PICOOS_VARIANT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../..")
set(_PICOOS_VARIANT_BASE "env:rpipico2w")

# buildcfg/*.ini を読んで、節ごとの値を _PICOOS_INI_<節>_<キー> に入れる(呼んだ側の範囲へ)
macro(_picoos_variant_load)
    file(GLOB _pv_files "${_PICOOS_VARIANT_ROOT}/buildcfg/*.ini")
    if(NOT _pv_files)
        message(FATAL_ERROR "buildcfg/*.ini が見つかりません(${_PICOOS_VARIANT_ROOT}/buildcfg)")
    endif()
    set(_PICOOS_INI_SECTIONS "")
    foreach(_pv_file ${_pv_files})
        # 書き換えたらconfigureをやり直させる(cmake -P のときは置けない)
        if(NOT CMAKE_SCRIPT_MODE_FILE)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pv_file}")
        endif()
        file(READ "${_pv_file}" _pv_text)
        # CMake のリストは ; と [ ] を特別に扱うので、行に分ける前に別の字へ置き換える
        string(REPLACE ";" "<SC>" _pv_text "${_pv_text}")
        string(REPLACE "[" "<LB>" _pv_text "${_pv_text}")
        string(REPLACE "]" "<RB>" _pv_text "${_pv_text}")
        string(REPLACE "\r" "" _pv_text "${_pv_text}")
        string(REPLACE "\n" ";" _pv_lines "${_pv_text}")
        set(_pv_sec "")
        set(_pv_key "")
        foreach(_pv_line IN LISTS _pv_lines)
            if(_pv_line MATCHES "^[ \t]*<SC>" OR _pv_line MATCHES "^[ \t]*$")
                continue()
            endif()
            if(_pv_line MATCHES "^<LB>([^<]+)<RB>[ \t]*$")
                string(MAKE_C_IDENTIFIER "${CMAKE_MATCH_1}" _pv_sec)
                list(APPEND _PICOOS_INI_SECTIONS "${CMAKE_MATCH_1}")
                set(_pv_key "")
            elseif(_pv_line MATCHES "^([A-Za-z0-9_.]+)[ \t]*=[ \t]*(.*)$")
                string(MAKE_C_IDENTIFIER "${CMAKE_MATCH_1}" _pv_key)
                set(_PICOOS_INI_${_pv_sec}_${_pv_key} "${CMAKE_MATCH_2}")
            elseif(_pv_line MATCHES "^[ \t]+(.*)$" AND NOT _pv_key STREQUAL "")
                # 字下げした行は直前のキーの続き
                set(_PICOOS_INI_${_pv_sec}_${_pv_key} "${_PICOOS_INI_${_pv_sec}_${_pv_key}} ${CMAKE_MATCH_1}")
            else()
                message(FATAL_ERROR "${_pv_file}: 読めない行です: ${_pv_line}")
            endif()
        endforeach()
    endforeach()
endmacro()

# -DNAME[=VAL] を NAME=VAL にして <out> へ足す
macro(_picoos_variant_define _pv_tok _pv_out _pv_where)
    if(NOT "${_pv_tok}" MATCHES "^-D([A-Za-z_][A-Za-z0-9_]*)(=(.*))?$")
        message(FATAL_ERROR "${_pv_where}: -DNAME[=VAL] 以外の旗は読めません: ${_pv_tok}")
    endif()
    if(CMAKE_MATCH_2 STREQUAL "")
        list(APPEND ${_pv_out} "${CMAKE_MATCH_1}=1")
    else()
        list(APPEND ${_pv_out} "${CMAKE_MATCH_1}=${CMAKE_MATCH_3}")
    endif()
endmacro()

function(picoos_read_variant env out)
    set(result "")
    if(env STREQUAL "" OR env STREQUAL "rpipico2w")
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    _picoos_variant_load()
    string(MAKE_C_IDENTIFIER "env:${env}" sec)
    if(NOT DEFINED _PICOOS_INI_${sec}_build_flags)
        set(envs "")
        foreach(s IN LISTS _PICOOS_INI_SECTIONS)
            if(s MATCHES "^env:(.+)$")
                list(APPEND envs "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        list(JOIN envs " " envs)
        message(FATAL_ERROR "buildcfg/ に版 '${env}' がありません。あるのは: rpipico2w ${envs}")
    endif()
    if(NOT _PICOOS_INI_${sec}_extends STREQUAL _PICOOS_VARIANT_BASE)
        message(FATAL_ERROR "env:${env}: extends が ${_PICOOS_VARIANT_BASE} ではないので読めません")
    endif()
    separate_arguments(toks UNIX_COMMAND "${_PICOOS_INI_${sec}_build_flags}")
    foreach(tok IN LISTS toks)
        if(tok STREQUAL "\${${_PICOOS_VARIANT_BASE}.build_flags}")
            continue()
        elseif(tok MATCHES "^\\$\\{([A-Za-z0-9_]+)\\.flags\\}$")
            set(part "${CMAKE_MATCH_1}")
            if(NOT DEFINED _PICOOS_INI_${part}_flags)
                message(FATAL_ERROR "env:${env}: 部品 [${part}] が buildcfg/ にありません")
            endif()
            separate_arguments(ptoks UNIX_COMMAND "${_PICOOS_INI_${part}_flags}")
            foreach(ptok IN LISTS ptoks)
                _picoos_variant_define("${ptok}" result "[${part}]")
            endforeach()
        else()
            _picoos_variant_define("${tok}" result "env:${env}")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# 単独で動かしたとき(cmake -P)は、読んだ旗を1行に1つ出す
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT DEFINED PICOOS_VARIANT)
        message(FATAL_ERROR "使い方: cmake -DPICOOS_VARIANT=<env の名前> -P pc/cmake/PicoVariant.cmake")
    endif()
    picoos_read_variant("${PICOOS_VARIANT}" _pv_defs)
    foreach(d IN LISTS _pv_defs)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${d}")
    endforeach()
endif()
