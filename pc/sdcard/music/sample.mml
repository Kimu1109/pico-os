; pico-os MML の書き方の見本(MUSIC_FORMAT.md)。ほとんどの命令を使っている
#title    書き方の見本
#composer pico-os
#tempo    132

; ドラムはマクロで。中で変えた波形や音量は、抜けると元に戻る
#macro kick  = @noise o5 v14 E-2 q8 c8
#macro snare = @noise o7 v11 E-2 q8 c8
#macro hat   = @noise_short o8 v5 q2 c16 c16

; メロディ。[ 共通 : 1番の終わり ]2 のあとに2番の終わり(3連符とタイ)
A @pulse50 v11 E-1 q7 o5 l8
A L [ c e g > c < b g e c | d f a > d < c+4 r4 : e d c < b > c4 r4 ]2
A   e12 f12 g12 a4 g4 e4 | c2^8 r8 r4

; ハモリ。細い矩形波を小さめに
B @pulse12 v6 q6 o4 l8
B L [ e g > c < g g b > d < b | f a > d < a e4 r4 : c e g e d4 r4 ]2
B   g2 e2 | e2^8 r8 r4

; ベースは三角波。最後の2小節だけ t で少しゆっくりにし、ループの頭で戻す
C @triangle v15 q7 o2 l4
C L [ c c g g | d d a+ a : f f g g ]2
C   f g t120 c2 | c2 r2 t132

D L [ [ $kick $hat $snare $hat ]4 : [ $kick $hat $snare $hat ]2 ]2
D   [ $kick $hat $snare $hat ]2 $kick $kick $snare $snare r2
